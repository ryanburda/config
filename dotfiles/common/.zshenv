#!/bin/zsh

# Add custom scripts to PATH
export PATH="$HOME/.local/bin:$PATH"

# dirsesh environment variables
export DIRSESH_LS_ROOT="$HOME/"
export DIRSESH_LS_MAX_DEPTH=8
export DIRSESH_LS_EXCLUDE="$HOME/Library:$HOME/Music/Music:$HOME/Pictures/Photo Booth Library:$HOME/Pictures/Photos Library.photoslibrary:$HOME/go:"
export DIRSESH_GIT_ROOT="$HOME/code"
export DIRSESH_GIT_MAX_DEPTH=0
