#!/bin/bash
# Switch to the last session; fall back to the only other session, or the
# session picker.
#
# Usage: tmux_last_session
#
# Meant to be run from a tmux keybind:
#
#   bind-key \; run-shell -b "tmux_last_session"

if [ -z "$TMUX" ]; then
  echo "Error: not inside tmux" >&2
  exit 1
fi

last=$(tmux display-message -p '#{client_last_session}')
current=$(tmux display-message -p '#{client_session}')
count=$(tmux display-message -p '#{server_sessions}')

if [ -n "$last" ] && [ "$last" != "$current" ]; then
  tmux switch-client -l
elif [ "$count" -eq 2 ]; then
  tmux switch-client -n
elif [ "$count" -gt 2 ]; then
  tmux popup -h 35% -w 40% -E "tmux_active_session_picker"
else
  tmux display-message "No other active sessions to switch to"
fi
