#!/bin/bash
# Kill a running tmux session, choosing it with fzf.
#
# Usage: tmux_kill_session_picker [session]
#
#   session  Kill this session instead of showing the picker.
#
# Meant to be run from a tmux popup:
#
#   bind-key K popup -h 35% -w 40% -E "tmux_kill_session_picker"
#
# A session built by a tsm configuration runs that configuration's `kill` on
# the way out, by way of the session-closed hook `tsm init` installs.

notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

session="$1"

# No session given: pick one with fzf.
if [ -z "$session" ]; then
  # Formatted rather than cut out of `tmux ls`, which would split a name at
  # its first colon.
  sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  if [ -z "$sessions" ]; then
    notify "No active sessions to kill"
    exit 1
  fi

  session=$(echo "$sessions" | fzf --cycle --prompt "Kill Session > ")

  [ -n "$session" ] || exit 0
fi

if ! tmux has-session -t "=$session" 2>/dev/null; then
  notify "Error: Session '$session' is not running"
  exit 1
fi

tmux kill-session -t "=$session"
