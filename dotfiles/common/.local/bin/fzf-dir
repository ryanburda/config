#!/usr/bin/env bash
#
# A reference `dirsesh at $(<cmd>)` command
#
# Add to your path and modify as needed to use:
# ```
# cp "<dirsesh-repo-root>/examples/fzf-dir" ~/.local/bin/fzf-dir
# dirsesh at "$(fzf-dir)"
# ```
#
# fzf-dir:
#   prints a directory, chosen with fzf.

selected=$(find "$HOME" -name ".*" -prune -o -type d -print | fzf --cycle --prompt "Directory > ")

# Backing out is not a failure: say nothing and succeed.
[ -n "$selected" ] || exit 0

printf '%s\n' "$selected"
