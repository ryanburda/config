#!/bin/zsh

# NAME
#   set_colorscheme - synchonizes neovim and terminal colorschemes.
#
# SYNOPSIS
#   set_colorscheme [-l] [-t] [theme_key]
#
# DESCRIPTION
#   Apply a colorscheme to both the terminal and neovim. With no theme_key, fzf
#   is used to pick one.
#   This script utilizes a hard coded associative list (dictionary) where the keys
#   are unique theme names that will show up in fzf and the values are strings each
#   containing:
#       * the neovim colorscheme
#       * the neovim background
#   in that order separated by a comma.
#
#   Wezterm has no colorscheme of its own here. It keys off the two values above:
#   $XDG_CONFIG_HOME/wezterm/colorschemes.lua carries a palette per
#   "<nvim_colorscheme>-<nvim_background>", derived from the neovim colorscheme itself.
#
#   The colorscheme changes happen as a result of either writing to files or from regeneration of config files:
#       - nvim is updated when a change is detected in $XDG_CONFIG_HOME/nvim/.colorscheme
#       - wezterm is updated by touching $XDG_CONFIG_HOME/wezterm/wezterm.lua
#       - other scripts exist for handling colorscheme changes to other CLIs such as aichat and lazygit.
#
#   envy's colorscheme_key is the saved default: the theme this machine comes
#   back to. tmux-settings layers shorter lived, per session choices on top
#   of it with -t.
#
# OPTIONS
#   -l  List the theme keys, one per line, and exit. Lets other pickers share
#       the table below instead of keeping a copy of it.
#   -d  Print the saved default key and exit.
#   -t  Transient. Apply the theme without recording it as the saved default.

: ${XDG_CONFIG_HOME:=$HOME/.config}

typeset -A themes=(
    ['Dark - Catppuccin']="catppuccin,dark"
    ['Dark - Everforest']="everforest,dark"
    ['Dark - Gruvbox']="gruvbox-material,dark"
    ['Dark - Kanagawa-paper-ink']="kanagawa-paper-ink,dark"
    ['Dark - Nightfox-dusk']="duskfox,dark"
    ['Dark - Nightfox-night']="nightfox,dark"
    ['Dark - Nightfox-nord']="nordfox,dark"
    ['Dark - Nordic']="nordic,dark"
    ['Dark - Vague']="vague,dark"
    ['Dark - Zenbones']="zenbones,dark"
    ['Light - Everforest']="everforest,light"
    ['Light - Gruvbox']="gruvbox-material,light"
    ['Light - Nightfox-dawn']="dawnfox,light"
    ['Light - Nightfox-day']="dayfox,light"
    ['Light - Zenbones']="zenbones,light"
)

list_themes(){
    printf "%s\n" "${(k)themes[@]}" | sort
}

default_key(){
    envy get colorscheme_key
}

apply_theme(){
    # Accepts a single parameter that is a valid key into the themes dictionary above.
    local theme_key=$1
    local values=${themes[$theme_key]}

    if [[ -z $values ]]; then
        return 1
    fi

    local nvim_colorscheme=$(print $values | awk -F ',' '{print $1}')
    local nvim_background=$(print $values | awk -F ',' '{print $2}')

    # Bail out when this is already what's on screen. tmux calls in here on
    # every session change and everything below is expensive enough -- a config
    # reload per nvim instance, a wezterm reload, a trip through gsettings --
    # that it's worth not doing for nothing.
    if [[ $nvim_colorscheme == $(envy get nvim_colorscheme) && $nvim_background == $(envy get nvim_background) ]]; then
        return 0
    fi

    envy set nvim_colorscheme $nvim_colorscheme
    envy set nvim_background $nvim_background

    reload_nvim_colors

    # Nudge wezterm to re-read its config.
    touch $XDG_CONFIG_HOME/wezterm/wezterm.lua

    # Tell delta which background it's on. It can work this out itself by
    # querying the terminal, but the OSC 11 query doesn't survive tmux, so
    # set it explicitly. `git config --global` writes these two keys into
    # ~/.gitconfig without disturbing anything else in there, and lazygit
    # picks them up too -- delta reads delta.* from git config whoever
    # invokes it.
    if [[ $nvim_background == 'light' ]]; then
        git config --global delta.light true
        git config --global delta.dark false
    else
        git config --global delta.light false
        git config --global delta.dark true
    fi
    dark_mode $(if [[ $nvim_background == 'light' ]]; then echo '-l'; fi)
}

transient=0

while getopts ":ldt" opt; do
    case $opt in
        l)
            list_themes
            exit 0
            ;;
        d)
            default_key
            exit 0
            ;;
        t)
            transient=1
            ;;
        \?)
            print -u2 "set_colorscheme: invalid option -$OPTARG"
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

theme_key=$1

if [[ -z $theme_key ]]; then
    theme_key=$(list_themes | fzf --cycle --header "$(default_key)")
    if [[ -z $theme_key ]]; then
        exit 0
    fi
fi

if [[ -z ${themes[$theme_key]} ]]; then
    print -u2 "set_colorscheme: unknown theme '$theme_key'"
    exit 1
fi

apply_theme $theme_key

if (( ! transient )); then
    envy set colorscheme_key $theme_key
    # A per session choice would win back this key on the next session change,
    # so choosing a new default gives up the one on this session.
    if [[ -n $TMUX ]]; then
        tmux set-option -qu @colorscheme
    fi
fi
