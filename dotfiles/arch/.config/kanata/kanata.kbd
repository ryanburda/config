(defcfg
  process-unmapped-keys yes

  ;; The Corne does all of this in its own firmware (esc/ctrl on the home-row
  ;; mod, a space layer-tap, and real LGUI/LALT thumbs), so grabbing it here
  ;; only double-applies the tap-holds and would drag it into the lalt/lmet
  ;; swap below -- which exists to put Super under the laptop's left thumb and
  ;; has no business touching a keyboard that already has one there. Leave it
  ;; alone and let ZMK's keymap reach the compositor verbatim.
  linux-dev-names-exclude (
    "ZMK Project Corne Keyboard"
  )
)

(defvar
  tap-time 200
  hold-time 200
  dbl-tap-time 200
)

(defsrc
  spc
  caps
  lsft
  rsft
  lalt
  lmet
)

(defalias
  ;; Space: tap for space, hold for nav layer.
  ;; (require-prior-idle 150) is what makes a tap-hold viable on space at all:
  ;; if any other key was pressed within 150ms before space, space resolves
  ;; instantly as a plain space and never enters the waiting state. That kills
  ;; both problems the tap-hold on space used to cause -- no deferred release to
  ;; trip auto-repeat, and Ctrl+Space works because the space is emitted
  ;; immediately while Ctrl is still held. The nav layer is reached by pausing
  ;; briefly, then holding space.
  nav (tap-hold-release $tap-time $hold-time spc (layer-toggle nav) (require-prior-idle 150))

  ;; Caps Lock: tap for escape, hold for control.
  ;; -press so Ctrl engages the instant another key is pressed. Deliberately no
  ;; require-prior-idle here: chords like Ctrl+S typed straight after a word must
  ;; still reach Ctrl rather than collapsing to Escape.
  esc-ctl (tap-hold-press $tap-time $hold-time esc lctl)

  ;; Shift: normal shift, but double-tapping one toggles caps lock.
  ;; tap-dance-eager emits the shift immediately on first press and keeps it held
  ;; for as long as the key is held, so Shift+key is completely unaffected --
  ;; nothing is deferred waiting for a second tap. Pressing any other real key
  ;; cancels the dance, so capitalising two words in a row ("A B") with the same
  ;; shift never toggles caps. The second tap emits caps alone (no shift), which
  ;; toggles caps lock on; double-tapping again turns it back off.
  ;; The two taps must be the same physical key -- lsft then rsft won't trigger.
  lsft-caps (tap-dance-eager $dbl-tap-time (lsft caps))
  rsft-caps (tap-dance-eager $dbl-tap-time (rsft caps))
)

(deflayer default
  @nav
  @esc-ctl
  @lsft-caps
  @rsft-caps
  ;; Swap left Alt and left Super, mirroring the Corne: the key the left thumb
  ;; falls on is Super (niri's Mod), and Alt moves one position out. Only the
  ;; left pair -- right Alt stays a real Alt and right Super a real Super.
  ;; This replaces niri's xkb altwin:swap_lalt_lwin, which applied to every
  ;; keyboard at once because kanata funnels them all through one device.
  lmet
  lalt
)

;; Vim-style navigation on nav layer
(deflayermap (nav)
  h left
  j down
  k up
  l right
  bspc del
)
