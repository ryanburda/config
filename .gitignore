# macos
.DS_Store

# nvim
dotfiles/common/.config/nvim/lua/plugins/integrations/*.lua
*en.utf-8.add.spl
.luarc.json
lazy-lock.json
nvim-pack-lock.json

# ssh
dotfiles/common/.ssh/*
!dotfiles/common/.ssh/config

# zsh extensions
dotfiles/common/.zsh/zshrc_extensions/*
!dotfiles/common/.zsh/zshrc_extensions/README.md

# systemd user service enablement (generated by systemctl --user enable)
dotfiles/arch/.config/systemd/user/*.target.wants/

# claude -- only settings.json is version controlled; the rest of ~/.claude is
# machine-local state (credentials, session history, project data)
dotfiles/common/.claude/*
!dotfiles/common/.claude/settings.json

# noctalia -- generated at runtime, not user preference.
# noctalia.kdl is the color scheme noctalia writes for niri (included from
# config.kdl with optional=true), and .local/state is the daemon-owned settings
# layer that noctalia_shadowed reports drift against.
dotfiles/arch/.config/niri/noctalia.kdl
dotfiles/arch/.local/state/
